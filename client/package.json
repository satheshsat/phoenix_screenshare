{
  "name": "client",
  "version": "1.0.0",
  "description": "Screen sharing and remote desktop client",
  "homepage": "https://github.com/satheshsat/screenshare",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "keywords": [
    "phoenix",
    "screenshare",
    "webrtc",
    "remote-desktop"
  ],
  "author": "Sathesh <satheshs.sat@gmail.com>",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.6",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "electron": "^42.0.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "satcs.phoenix.screenshare",
    "productName": "Phoenix Screen Share",
    "win": {
      "target": "nsis",
      "icon": "icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "icon.png",
      "maintainer": "Sathesh <satheshs.sat@gmail.com>",
      "category": "Network"
    }
  }
}